{
  "name": "bijoux",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run server\" \"npm run client\"",
    "setup": "npm install && npm install --prefix client",
    "create-admin": "node scripts/createAdmin.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.0"
  }
}
